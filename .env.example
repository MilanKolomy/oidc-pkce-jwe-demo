# Copy to .env and fill in. The .env file never enters the repository.

# dev  — errors are shown in the response
# prod — the response carries a correlation identifier only, details go to var/app.log
APP_ENV=dev

DB_HOST=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Google OAuth client, type "Web application".
# Authorised redirect URI must match exactly:
#   http://localhost:8080/callback
#   https://monet.super-web.cz/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
