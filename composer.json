{
    "name": "milankolomy/oidc-pkce-jwe-demo",
    "description": "OpenID Connect login with PKCE and an encrypted application token (JWE).",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-sodium": "*",
        "web-token/jwt-library": "^3.4"
    },
    "replace": {
        "paragonie/sodium_compat": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1.33"
        },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
